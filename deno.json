{
  "$schema": "https://raw.githubusercontent.com/denoland/deno/refs/heads/main/cli/schemas/config-file.v1.json",
  "name": "@bastianplsfix/html",
  "version": "0.2.0",
  "license": "MIT",
  "exports": {
    ".": "./mod.ts",
    "./jsx-runtime": "./jsx-runtime.ts",
    "./jsx-dev-runtime": "./jsx-dev-runtime.ts",
    "./response": "./response.ts"
  },
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "@bastianplsfix/html",
    "jsxPrecompileSkipElements": [
      "script",
      "style"
    ]
  },
  "imports": {
    "@bastianplsfix/html": "./mod.ts",
    "@bastianplsfix/html/jsx-dev-runtime": "./jsx-dev-runtime.ts",
    "@bastianplsfix/html/jsx-runtime": "./jsx-runtime.ts",
    "@bastianplsfix/html/response": "./response.ts",
    "@std/assert": "jsr:@std/assert@^1.0.19"
  },
  "lint": {
    "rules": {
      "exclude": [
        "jsx-key"
      ]
    }
  },
  "tasks": {
    "bench": "deno bench bench/",
    "bench:check": "deno test bench/regression_budget.tsx",
    "bench:profile": "deno run --v8-flags=--expose-gc bench/profile.tsx",
    "check": "deno task types:check && deno fmt --check && deno fmt --check .github/scripts && deno lint && deno lint .github/scripts && deno check mod.ts jsx-runtime.ts jsx-dev-runtime.ts response.ts bench/*.tsx docs/main.ts docs/server.ts docs/test/handler_test.ts test/*.tsx tools/*.ts .github/scripts/*.ts && deno task doc:lint && deno test --allow-read=docs/static/styles.css && deno test --config test/deno.dev.json test/dev_diagnostics.tsx && deno test .github/scripts/release_test.ts",
    "doc:lint": "deno doc --lint mod.ts jsx-runtime.ts jsx-dev-runtime.ts response.ts",
    "docs": "deno serve --watch --allow-read=docs/static/styles.css docs/main.ts",
    "docs:start": "deno serve --allow-read=docs/static/styles.css docs/main.ts",
    "test": "deno test --allow-read=docs/static/styles.css",
    "test:dev": "deno test --config test/deno.dev.json test/dev_diagnostics.tsx",
    "test:watch": "deno test --allow-read=docs/static/styles.css --watch",
    "types:check": "deno run --allow-read=src/jsx_types.ts tools/generate_jsx_types.ts --check",
    "types:generate": "deno run --allow-write=src/jsx_types.ts tools/generate_jsx_types.ts"
  },
  "publish": {
    "include": [
      "deno.json",
      "LICENSE",
      "README.md",
      "CHANGELOG.md",
      "CONTRIBUTING.md",
      "DESIGN.md",
      "RELEASING.md",
      "SECURITY.md",
      "*.ts",
      "src/**/*.ts"
    ]
  }
}
